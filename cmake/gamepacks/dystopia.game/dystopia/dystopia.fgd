@PointClass base(Targetname, Parentname, Angles) studioprop("models/props/dys_turret.mdl") = npc_turret_ceiling : "Ceiling Turret"
[
	spawnflags(Flags) =
	[
		4 : "Start Inactive" : 0
		8 : "Thermal (detects stealthers)" : 0
		16 : "Start Invincible" : 0
 		32 : "No Shadows" : 0
	]

	maxhealth(integer) : "Turret's health" : 250
	minhealthdmg(integer) : "Min req'd damage for hurting turret" : 0
	respawntime(float) : "Rebuild time (s)" : 0 : "Seconds before the turret rebuilds after being destroyed. 0 = use the default rebuild timer."

	team(choices) :"Team" : 0 =
	[
		2: "Punks"
		3: "Corps"
	]

	// Inputs
	input Enable(void)		: "If closed, open."
	input Disable(void)		: "If open, close."
	input Toggle(void)		: "Toggle - If open, close. If closed, open."
	input SetTeamTouched(void)	: "Set team to Activator's"
	input SetPunks(void)	: "Enable for Punks"
	input SetCorps(void)	: "Enable for Corps"
	input SetInvincible(void) : "Make it invulnerable to all damage"
	input SetVincible(void)   : "Make it able to take damage again"

	// Outputs
	output OnDeploy(void)	: "Turret is becoming active and dangerous."
	output OnRetire(void)	: "Turret is becoming inactive and harmless."
]

@PointClass base(Targetname,Studiomodel,Angles) studioprop() = dys_item :
	"Dystopia carryable item."
[
	spawnflags(Flags) =
	[
		1 : "Spawn once only" : 0
	]

	filter(filterclass) : "Filter" : "" : "The name of the filter entity."
	RespawnDelay(float) : "Respawn Delay" : 0 : "Seconds to wait before respawning on drop (zero = instant, negative = never respawns)"
	RespawnDelayOnCapture(float) : "Respawn delay after capture" : "0.5" : "Seconds to wait before respawning after being captured in a trigger_item"
	CarriedInterval(float) : "Carried interval" : "2.0" : "Interval in seconds between firing the OnCarried output (minimum 0.1)"
	
	input Respawn(void) : "Force the item to respawn (does not work after the trigger_item has fired)"
	input DisableItem(void) : "Disable and turn off the item. Removes from player if being carried."

	output OnDropped(void) : "Called when the item is dropped (only when it has a delay before spawning)."
	output OnPickup(void) : "Called when the item is picked up."
	output OnPickupDenied(void) : "Called when a player touches the item but fails to pass the filter."
	output OnCarried(void) : "Called every Carried Interval to whoever is carrying this item (for game_text alerts and such)"
	output OnRespawn(void) : "Called when the item respawns."
]

@SolidClass base(Trigger) = trigger_item : "Detects if a player has a dys_item and fires an output"
[
	ItemsRequired(integer) : "ItemsRequired" : 1 : "How many items are required to fire the trigger"
	ItemName(string) : "Item Name" : "" : "If a special type of item is required, enter its name here"

	output OnItem(void) : "When a player carries a dys_item into this trigger"
	output OnTotalItems(void)	:	"When this trigger has hit the item limit (it will reset to zero automatically)"
]

