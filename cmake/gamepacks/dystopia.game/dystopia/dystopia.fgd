@FilterClass base(BaseFilter) iconsprite("editor/filter_team.vmt") = filter_activator_team :
	"A filter that filters by the team of the activator."
[
	filterteam(choices) : "Filter Team Number" : 2 : "The team number to filter by.  If the filter mode is Allow, only entities whose "+
		"team number matches the given team will pass the filter. If the filter mode is Disallow, "+
		"all entities EXCEPT those whose team number matches the given team will pass the filter." =
	[
		2 : "Punks"
		3 : "Corps"
	]

	// Inputs
	input SetPunks(void) : "Set Team to Punks"
	input SetCorps(void) : "Set Team to Corps"
	input SetTouched(void) : "Set Team to activator's team"
	input SetAll(void) : "Set Team to 0 (general access)"
]

@FilterClass base(BaseFilter) size(-8 -8 -8, 8 8 8) = filter_activator_playerclass :
	"A filter that filters by the player class of the activator."
[
	filterclass(choices) : "Filter Class Number" : 3 : "The class number to filter by.  If the filter mode is Allow, only entities whose "+
		"class number matches the given class will pass the filter. If the filter mode is Disallow, "+
		"all entities EXCEPT those whose class number matches the given class will pass the filter." =
	[
		1 : "Light"
		2 : "Medium"
		3 : "Heavy"
	]

	// Inputs
	input SetLight(void) : "Set Class to Light"
	input SetMedium(void) : "Set Class to Medium"
	input SetHeavy(void) : "Set Class to Heavy"
	input SetTouched(void) : "Set Class to activator's class"
	input SetAll(void) : "Set Class to 0 (general access)"
]

