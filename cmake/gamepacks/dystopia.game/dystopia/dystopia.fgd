@SolidClass base(func_brush) = func_brush_colorblend :
	"Acts like a func_brush but has can blend from one color to another over a given duration. "+
	"See BlendDuration keyvalue and BlendToColor and SetBlendDuration inputs. NOTE: This entity "+
	"is only updated on the client side, so long blend durations (over 5 seconds or so) should "+
	"be avoided as they will only be transmitted to the client when entering their PVS. "+
	"Updates 20 times per second while blending."
[
	BlendDuration(float)			:	"Blend Duration"	:	"1.0"		:		"Duration for color blending to take place in seconds."

	input BlendToColor(color255)	:	"Blend from our current color to this color."
	input SetBlendDuration(float)	:	"Duration for color blending to take place in seconds."
]


